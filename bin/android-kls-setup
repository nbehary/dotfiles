#!/bin/bash
# android-kls-setup: Setup custom Kotlin Language Server classpath generator for Android projects

set -e

# Path to the custom gradle finder script in dotfiles
FINDER_SCRIPT="$HOME/.config/nvim/projectClassPathFinder.gradle"

if [ ! -f "$FINDER_SCRIPT" ]; then
    echo "Error: Could not find projectClassPathFinder.gradle at $FINDER_SCRIPT" >&2
    exit 1
fi

# Detect Android project
if [ ! -f "build.gradle" ] && [ ! -f "build.gradle.kts" ] && [ ! -f "settings.gradle" ] && [ ! -f "settings.gradle.kts" ]; then
    echo "Error: This directory does not look like a Gradle/Android project root (no build/settings.gradle found)." >&2
    exit 1
fi

echo "Creating 'kls-classpath' script in the current directory..."

cat > kls-classpath << EOF
#!/bin/bash
# Automatically generated by android-kls-setup

FINDER_SCRIPT="$FINDER_SCRIPT"

if [ ! -f "\$FINDER_SCRIPT" ]; then
    echo "Error: projectClassPathFinder.gradle not found at \$FINDER_SCRIPT" >&2
    exit 1
fi

# Run gradle to extract the classpath, filter, and join with colons
./gradlew -I "\$FINDER_SCRIPT" kotlinLSPProjectDeps --quiet --no-configuration-cache 2>/dev/null | \\
    grep '^kotlin-lsp-gradle ' | \\
    cut -d' ' -f2- | \\
    paste -sd ":" -
EOF

chmod +x kls-classpath
echo "✓ Created kls-classpath and made it executable."

# Patch the KLS jar for AGP 9 compatibility (idempotent — safe to run multiple times)
PATCH_SCRIPT="$HOME/.config/nvim/kls-patch-agp9.sh"
if [ -f "$PATCH_SCRIPT" ]; then
    echo ""
    echo "Applying AGP 9 patch to kotlin-language-server jar..."
    bash "$PATCH_SCRIPT"
else
    echo ""
    echo "⚠ KLS jar patch script not found at $PATCH_SCRIPT"
    echo "  If using AGP 9+, run the patch manually to fix getBootClasspath() errors."
fi

echo ""
echo "To finish setup:"
echo "1. Run a full Gradle build if you haven't recently:"
echo "   ./gradlew assembleDebug"
echo "2. Restart Neovim fully (not just :LspRestart) for the jar patch to take effect."
