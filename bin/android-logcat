#!/usr/bin/env bash
# Display logcat for the current Android project's app.
#
# Usage: android-logcat
#
# Run from the project root (where gradlew lives). Reads applicationId from
# build.gradle.kts or build.gradle (looking in current dir and ./app/).

set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
err() { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

# --- find applicationId in gradle files ---
PACKAGE=""
for f in build.gradle.kts app/build.gradle.kts build.gradle app/build.gradle; do
  [[ -f "$f" ]] || continue
  PACKAGE=$(grep -m 1 -oE 'applicationId[[:space:]]*=?[[:space:]]*"[^"]+"' "$f" \
            | grep -oE '"[^"]+"' | tr -d '"' || true)
  [[ -n "$PACKAGE" ]] && break
done

if [[ -z "$PACKAGE" ]]; then
  err "Could not find applicationId in any build.gradle(.kts)"
  exit 1
fi

log "Displaying logcat for $PACKAGE..."
adb logcat --pid="$(adb shell pidof "$PACKAGE" 2>/dev/null || echo '')" 2>/dev/null || adb logcat
