#!/usr/bin/env bash
# claude-diff-display — render a unified diff and prompt accept/reject.
# Runs inside a Neovim terminal buffer.
#
# Usage: claude-diff-display <diff-file> <response-pipe>

set -euo pipefail

DIFF_FILE="${1:?claude-diff-display: missing diff-file argument}"
RESPONSE_PIPE="${2:?claude-diff-display: missing response-pipe argument}"

# Safety net: if the script exits for any reason without writing to the pipe
# (e.g. no tty, user closes the window), write 'reject' so the hook unblocks.
_on_exit() { printf 'reject' > "$RESPONSE_PIPE" 2>/dev/null || true; }
trap '_on_exit' EXIT

# ── Rendering ─────────────────────────────────────────────────────────────────

render_diff() {
    if command -v delta >/dev/null 2>&1; then
        delta --paging=never < "$DIFF_FILE"
        return
    fi

    # Lightweight ANSI colorizer — no external deps required
    while IFS= read -r line; do
        case "$line" in
            '--- '*|'+++ '*) printf '\033[1m%s\033[0m\n'  "$line" ;;
            '-'*)            printf '\033[31m%s\033[0m\n' "$line" ;;
            '+'*)            printf '\033[32m%s\033[0m\n' "$line" ;;
            '@@'*)           printf '\033[36m%s\033[0m\n' "$line" ;;
            *)               printf '%s\n'                "$line" ;;
        esac
    done < "$DIFF_FILE"
}

render_diff

# ── Prompt ────────────────────────────────────────────────────────────────────

printf '\n'
printf '\033[1;33m  ══════════════════════════════════════════════════════\033[0m\n'
printf '\033[1;33m    Accept these changes?   \033[1;32my\033[1;33m = yes   \033[1;31mN / any\033[1;33m = no\033[0m\n'
printf '\033[1;33m  ══════════════════════════════════════════════════════\033[0m\n'
printf '  > '

# Read a single character; fall back to /dev/tty if stdin is not a tty
if [ -t 0 ]; then
    IFS= read -r -s -n1 char
else
    IFS= read -r -s -n1 char < /dev/tty
fi

printf '%s\n\n' "$char"

trap - EXIT  # Response is being written normally; disable the safety trap

if [ "$char" = "y" ] || [ "$char" = "Y" ]; then
    printf '\033[1;32m  ✓  Change accepted\033[0m\n\n'
    printf 'accept' > "$RESPONSE_PIPE"
else
    printf '\033[1;31m  ✗  Change rejected\033[0m\n\n'
    printf 'reject' > "$RESPONSE_PIPE"
fi
